{
  // Owners implicitly own every tag, so only automation tags need listing.
  "tagOwners": {
    "tag:ci":           ["tag:ci"],
    "tag:proxmox":      ["tag:ci"],
    "tag:node":         ["tag:ci"],
    "tag:k8s-operator": ["tag:ci"],
    // tag:ci is co-owner so the Terraform/CI identity can retag an existing
    // proxy device in place; the operator only assigns tags at registration,
    // and re-registering would change the device's IP and MagicDNS name.
    "tag:service":      ["tag:k8s-operator", "tag:ci"],
    // Traefik's proxy only. Split out of tag:service so externally shared
    // guests can be granted the web entrypoint without also reaching every
    // other operator-exposed Service (copyparty, AdGuard).
    "tag:web":          ["tag:k8s-operator", "tag:ci"],
    "tag:minecraft":    ["tag:ci"],
  },

  "acls": [
    {
      "action": "accept",
      "src":    ["autogroup:owner"],
      "dst":    ["*:*"]
    },

    // Tailscale requires this network rule alongside the matching ssh rule below.
    {
      "action": "accept",
      "src":    ["autogroup:owner"],
      "dst":    ["autogroup:self:*"]
    },

    {
      "action": "accept",
      "src":    ["tag:ci"],
      "dst": [
        "tag:proxmox:22",
        "tag:proxmox:8006",
        "tag:node:6443",
        "tag:node:50000"
      ]
    },

    {
      "action": "accept",
      "src":    ["autogroup:shared"],
      "dst":    ["tag:minecraft:25565", "tag:minecraft:8100"]
    },

    {
      "action": "accept",
      "src":    ["tag:node"],
      "dst":    ["tag:node:*"]
    },

    {
      "action": "accept",
      "src":    ["tag:node"],
      "dst":    ["tag:proxmox:3260"]
    },

    {
      "action": "accept",
      "src":    ["tag:k8s-operator"],
      "dst":    ["tag:node:*"]
    },

    {
      "action": "accept",
      "src":    ["tag:service"],
      "dst":    ["tag:service:*"]
    },

    // Lets AdGuard forward fold-hen.ts.net queries via the Tailscale resolver.
    {
      "action": "accept",
      "src":    ["tag:node"],
      "dst":    ["tag:service:*", "tag:web:*"]
    },

    // Tailnet DNS override forces every client through AdGuard, so anything that
    // accepts tailnet DNS needs this or it loses resolution entirely.
    {
      "action": "accept",
      "src":    ["autogroup:owner", "tag:ci"],
      "dst":    ["tag:service:53"]
    },

    // Shared guests get the Traefik entrypoint (every app behind it is gated by
    // Authentik) plus DNS, and nothing else that the operator happens to expose.
    // Note the operator only assigns tags when a proxy device first registers,
    // so moving an existing one between tags needs an in-place API retag
    // (POST /api/v2/device/<id>/tags) — re-registering would change its
    // Tailscale IP and MagicDNS name, which AdGuard's *.nerine.dev rewrites
    // and the operator's API-proxy certificate both depend on.
    {
      "action": "accept",
      "src":    ["autogroup:shared"],
      "dst":    ["tag:web:80", "tag:web:443", "tag:service:53"]
    }
  ],

  "ssh": [
    {
      "action": "accept",
      "src":    ["autogroup:owner"],
      "dst":    ["tag:proxmox", "tag:node", "tag:minecraft"],
      "users":  ["autogroup:nonroot", "root"]
    },

    {
      "action": "accept",
      "src":    ["autogroup:owner"],
      "dst":    ["autogroup:self"],
      "users":  ["autogroup:nonroot", "root"]
    },

    {
      "action": "accept",
      "src":    ["tag:ci"],
      "dst":    ["tag:proxmox"],
      "users":  ["autogroup:nonroot", "root"]
    }
  ],

  "autoApprovers": {
    "routes": {
      "10.244.0.0/16":  ["tag:node"], // Pod CIDR
      "10.96.0.0/12":   ["tag:node"]  // Service CIDR
    }
  },

  // Impersonating the owner avoids hardcoding emails in the cluster.
  "grants": [
    {
      "src": ["autogroup:owner"],
      "dst": ["tag:k8s-operator"],
      "app": {
        "tailscale.com/cap/kubernetes": [{
          "impersonate": {
            "groups": ["system:masters"]
          }
        }]
      }
    }
  ],

  // Key expiry is set by tailscale_device_key.infra in Terraform/tailscale.tf.
  "nodeAttrs": [
    {
      "target": ["tag:node", "tag:service", "tag:web", "tag:proxmox"],
      "attr":   ["funnel:deny"]
    }
  ],

}
