# Copy to .env (gitignored) at the repo root. Loaded by mise (.mise.toml) and scripts/setup-env.sh.

# Bitwarden Secrets Manager machine-account token; setup-env.sh fetches every other credential with it.
BWS_ACCESS_TOKEN=

# Optional: kubeconfig used by Terraform's Kubernetes/Helm providers (default: ~/.kube/config).
# KUBE_CONFIG_PATH=
