global
    log stdout format raw local0

defaults
    mode tcp
    log global
    option tcplog
    timeout connect 10s
    timeout client 30s
    timeout server 30s

frontend http
    bind *:80
    default_backend traefik-http

frontend https
    bind *:443
    default_backend traefik-https

# Traefik backend: literal tailnet IP of the ts-traefik operator device,
# resolved once at Ansible deploy time from `tailscale status` on the control
# node (see Ansible/setup-oracle.yaml pre_tasks). The VPS runs tailscale with
# --accept-dns=false (by design, see AGENTS.md), so MagicDNS names MUST NOT be
# used here — HAProxy would fail to resolve them at startup and crash-loop.
# If the traefik tailnet device is recreated and its IP changes, outside
# access breaks until setup-oracle.yaml is re-run (ansible.yaml CI).
backend traefik-http
    server traefik {{ traefik_tailscale_ip }}:80 send-proxy-v2

backend traefik-https
    server traefik {{ traefik_tailscale_ip }}:443 send-proxy-v2
