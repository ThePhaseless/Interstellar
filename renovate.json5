{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
  ],
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    ignoreTests: true,
  },
  kubernetes: {
    managerFilePatterns: [
      '/(^|/)Kubernetes/.+\\.ya?ml$/',
    ],
  },
  // Four-segment assembly versions: Jellyfin resolves a plugin install against
  // this manifest, not against the three-segment git tags the releases carry.
  customDatasources: {
    'jellyfin-security-manifest': {
      defaultRegistryUrlTemplate: 'https://raw.githubusercontent.com/ZL154/JellyfinSecurity/main/manifest.json',
      format: 'json',
      // Upstream publishes each release twice, once per Jellyfin ABI (10.11 and
      // 12). A server older than a build's targetAbi answers its install with a
      // 404, and `jellyfin_plugin` replaces destroy-first, so a mismatched pin
      // uninstalls the working build before failing. Keep this major in step
      // with the jellyfin/jellyfin image, in the same commit as the pin.
      transformTemplates: [
        '{"releases": [$[0].versions[$split(targetAbi, ".")[0] = "12"].{"version": version}]}',
      ],
    },
  },
  packageRules: [
    {
      description: 'Ignore broken and legacy LinuxServer qBittorrent tags',
      matchManagers: [
        'kubernetes',
      ],
      matchPackageNames: [
        'linuxserver/qbittorrent',
      ],
      allowedVersions: '!/^(20\\.|5\\.2\\.)/',
    },
    {
      automerge: true,
      groupName: 'All non-major dependencies',
      groupSlug: 'all-minor-patch',
      ignoreTests: true,
      matchPackageNames: [
        '*',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      // Jellyfin releases run database migrations with no downgrade path, so
      // each one waits for a backup and a manual merge, outside the group.
      matchPackageNames: [
        'jellyfin/jellyfin',
      ],
      groupName: 'Jellyfin',
      groupSlug: 'jellyfin',
      automerge: false,
    },
    {
      matchDatasources: [
        'github-releases',
      ],
      matchPackageNames: [
        'siderolabs/talos',
        'kubernetes/kubernetes',
      ],
      groupName: 'talos-cluster',
      groupSlug: 'talos-cluster',
    },
    {
      // Each Talos minor caps the Kubernetes minor it supports, and upgrade-k8s
      // moves one minor at a time, so these wait for a human.
      matchDatasources: [
        'github-releases',
      ],
      matchPackageNames: [
        'kubernetes/kubernetes',
      ],
      matchUpdateTypes: [
        'minor',
        'major',
      ],
      automerge: false,
    },
  ],
  'pre-commit': {
    enabled: true,
    automerge: true,
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/\\.tf$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[^:]+?) depName=(?<depName>.+?)( versioning=(?<versioning>.+?))?( extractVersion=(?<extractVersion>.+?))?( registryUrl=(?<registryUrl>.+?))?\\s.+?[:=]\\s*["\']?(?<currentValue>.+?)["\']?\\s',
      ],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}',
      extractVersionTemplate: '{{#if extractVersion}}{{{extractVersion}}}{{else}}^v?(?<version>.+)${{/if}}',
    },
  ],
}
