{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'local>ThePhaseless/renovate-config',
  ],
  kubernetes: {
    managerFilePatterns: [
      '/(^|/)Kubernetes/.+\\.ya?ml$/',
    ],
  },
  packageRules: [
    {
      description: 'Ignore broken and legacy LinuxServer qBittorrent tags',
      matchManagers: [
        'kubernetes',
      ],
      matchPackageNames: [
        'linuxserver/qbittorrent',
      ],
      allowedVersions: '!/^(20\\.|5\\.2\\.)/',
    },
    {
      matchDatasources: [
        'github-releases',
      ],
      matchPackageNames: [
        'siderolabs/talos',
        'kubernetes/kubernetes',
      ],
      groupName: 'talos-cluster',
      groupSlug: 'talos-cluster',
    },
    {
      // Each Talos minor caps the Kubernetes minor it supports, and upgrade-k8s
      // moves one minor at a time, so these wait for a human.
      matchDatasources: [
        'github-releases',
      ],
      matchPackageNames: [
        'kubernetes/kubernetes',
      ],
      matchUpdateTypes: [
        'minor',
        'major',
      ],
      automerge: false,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/\\.tf$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[^:]+?) depName=(?<depName>.+?)( versioning=(?<versioning>.+?))?( extractVersion=(?<extractVersion>.+?))?( registryUrl=(?<registryUrl>.+?))?\\s.+?[:=]\\s*["\']?(?<currentValue>.+?)["\']?\\s',
      ],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}',
      extractVersionTemplate: '{{#if extractVersion}}{{{extractVersion}}}{{else}}^v?(?<version>.+)${{/if}}',
    },
  ],
}
