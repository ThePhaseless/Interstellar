{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'local>ThePhaseless/renovate-config',
  ],
  packageRules: [
    {
      description: 'LinuxServer once published the Ubuntu base version (20.04.1) as a tag',
      matchPackageNames: [
        'linuxserver/qbittorrent',
      ],
      allowedVersions: '!/^20\\./',
    },
    {
      matchDatasources: [
        'github-releases',
      ],
      matchPackageNames: [
        'siderolabs/talos',
        'kubernetes/kubernetes',
      ],
      groupName: 'talos-cluster',
      groupSlug: 'talos-cluster',
    },
    {
      // Each Talos minor caps the Kubernetes minor it supports, and upgrade-k8s
      // moves one minor at a time, so these wait for a human.
      matchDatasources: [
        'github-releases',
      ],
      matchPackageNames: [
        'kubernetes/kubernetes',
      ],
      matchUpdateTypes: [
        'minor',
        'major',
      ],
      automerge: false,
    },
  ],
}
