{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
  ],
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    ignoreTests: true,
  },
  kubernetes: {
    managerFilePatterns: [
      '/(^|/)Kubernetes/.+\\.ya?ml$/',
    ],
  },
  // Four-segment assembly versions: Jellyfin resolves a plugin install against
  // this manifest, not against the three-segment git tags the releases carry.
  customDatasources: {
    'jellyfin-security-manifest': {
      defaultRegistryUrlTemplate: 'https://raw.githubusercontent.com/ZL154/JellyfinSecurity/main/manifest.json',
      format: 'json',
      // Upstream publishes each release twice, once per Jellyfin ABI, and the
      // Jellyfin 12 build sorts above its 10.11 twin under loose versioning.
      // The server silently declines a newer-ABI plugin, so `jellyfin_plugin`
      // times out rather than erroring. Raise to 11/12 when the server moves.
      transformTemplates: [
        '{"releases": [$[0].versions[$split(targetAbi, ".")[0] = "10"].{"version": version}]}',
      ],
    },
  },
  packageRules: [
    {
      description: 'Ignore broken and legacy LinuxServer qBittorrent tags',
      matchManagers: [
        'kubernetes',
      ],
      matchPackageNames: [
        'linuxserver/qbittorrent',
      ],
      allowedVersions: '!/^(20\\.|5\\.2\\.)/',
    },
    {
      automerge: true,
      groupName: 'All non-major dependencies',
      groupSlug: 'all-minor-patch',
      ignoreTests: true,
      matchPackageNames: [
        '*',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      matchDatasources: [
        'github-releases',
      ],
      matchPackageNames: [
        'siderolabs/talos',
        'kubernetes/kubernetes',
      ],
      groupName: 'talos-cluster',
      groupSlug: 'talos-cluster',
    },
  ],
  'pre-commit': {
    enabled: true,
    automerge: true,
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/\\.tf$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[^:]+?) depName=(?<depName>.+?)( versioning=(?<versioning>.+?))?( extractVersion=(?<extractVersion>.+?))?( registryUrl=(?<registryUrl>.+?))?\\s.+?[:=]\\s*["\']?(?<currentValue>.+?)["\']?\\s',
      ],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}',
      extractVersionTemplate: '{{#if extractVersion}}{{{extractVersion}}}{{else}}^v?(?<version>.+)${{/if}}',
    },
  ],
}
